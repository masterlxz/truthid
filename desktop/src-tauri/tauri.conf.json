{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TruthID",
  "version": "2.2.0",
  "identifier": "io.truthid.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TruthID",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2Q0U3NUQ0N0ExQjQ5QkMKUldTOFNSdDYxSFhPbG56emJBYzROamcrSlo3NkRjL2p5Y3lIdGh0cFVJa21SbFZ4SG8rZnF2MEQK",
      "endpoints": [
        "https://github.com/masterlxz/truthid/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
